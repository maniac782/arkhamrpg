rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Investigator sheets are p1 to p12.
    function isSlot(s) { return s.matches('p([1-9]|1[0-2])'); }
    function signedIn() { return request.auth != null; }
    function lockDoc(s) { return /databases/$(database)/documents/locks/$(s); }
    function grantDoc(s) { return /databases/$(database)/documents/grants/$(request.auth.uid)/keys/$(s); }

    // This device unlocked slot s (or 'master') with the passcode that is set right now.
    function holdsKey(s) {
      return signedIn() && exists(lockDoc(s)) && exists(grantDoc(s))
        && get(grantDoc(s)).data.code == get(lockDoc(s)).data.code;
    }
    function isMaster() { return holdsKey('master'); }
    // The GM chooses their own PIN (locks/gm). It runs the GM tools; the master key can view them and reset the PIN.
    function isGM() { return holdsKey('gm'); }
    function gmView() { return isGM() || isMaster(); }
    function canEdit(s) { return isMaster() || !exists(lockDoc(s)) || holdsKey(s); }

    // Character sheets: everyone can view; editing a locked sheet needs its passcode or the master key.
    // Anyone can add a new investigator; only the master key can remove one.
    match /characters/{slot} {
      allow read: if true;
      allow create, update: if isSlot(slot) && signedIn() && canEdit(slot);
      allow delete: if isSlot(slot) && isMaster();
      // The GM can award XP, start sessions and refill pools on any sheet, but nothing else.
      allow update: if isSlot(slot) && isGM() && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['xpTotal','xpUnused','insightChance','insight','habitual','lucky','traumaMod','regular','horror','log']);
    }

    // Passcodes: nobody can read them. Set one on an open sheet; change or remove it with the passcode or master key.
    // The master key (locks/master) can only be set in the Firebase console.
    // locks/gm is the GM PIN: anyone can set it while none exists; the GM or the master key can change or clear it.
    match /locks/{slot} {
      allow read: if false;
      allow create: if (isSlot(slot) || slot == 'gm') && signedIn() && request.resource.data.code is string
        && request.resource.data.code.size() >= 4 && request.resource.data.code.size() <= 64;
      allow update: if (isSlot(slot) || slot == 'gm') && (isMaster() || holdsKey(slot)) && request.resource.data.code is string
        && request.resource.data.code.size() >= 4 && request.resource.data.code.size() <= 64;
      allow delete: if (isSlot(slot) || slot == 'gm') && (isMaster() || holdsKey(slot));
    }

    // A device's saved keys: grants/{device}/keys/{slot or 'master'}.
    // Only that device can see or delete them, and a key is only accepted if its code is correct.
    match /grants/{owner}/keys/{slot} {
      allow read, delete: if signedIn() && request.auth.uid == owner;
      allow create, update: if signedIn() && request.auth.uid == owner
        && (isSlot(slot) || slot == 'master' || slot == 'gm')
        && exists(lockDoc(slot))
        && request.resource.data.code == get(lockDoc(slot)).data.code;
    }

    // Party settings (house rules on/off): everyone can read, only the master key can change.
    match /settings/{doc} {
      allow read: if true;
      allow write: if isMaster() && doc == 'house' && request.resource.data.keys().hasOnly(['on'])
        && request.resource.data.on is bool;
      // settings/gm just says whether a GM PIN is set, so the page knows what to show.
      allow write: if doc == 'gm' && (isGM() || isMaster()) && request.resource.data.keys().hasOnly(['set'])
        && request.resource.data.set is bool;
    }

    // GM tools. Turn tracker and campaign: everyone reads, only the GM writes.
    match /table/{doc} {
      allow read: if true;
      allow write: if isGM() && doc == 'state';
    }
    match /campaign/{doc} {
      allow read: if true;
      allow write: if isGM();
    }
    // Enemies and handouts: players only see what the GM has revealed (a handout to one player needs that sheet's key).
    match /enemies/{id} {
      allow read: if gmView() || resource.data.shown == true;
      allow write: if isGM();
    }
    match /clues/{id} {
      allow read: if gmView() || (resource.data.shown == true
        && (resource.data.to == 'all' || (isSlot(resource.data.to) && canEdit(resource.data.to))));
      allow write: if isGM();
    }
    // Private GM notes.
    match /gm/{doc} {
      allow read: if gmView();
      allow write: if isGM();
    }
    // The GM's own activity log.
    match /gmlog/{id} {
      allow read: if gmView();
      allow create, delete: if isGM();
    }
    // Activity history for session recaps: anyone who can edit a sheet can add to its history.
    match /history/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.slot is string
        && ((isSlot(request.resource.data.slot) && (canEdit(request.resource.data.slot) || isGM()))
          || (request.resource.data.slot == 'gm' && isGM()));
      allow delete: if gmView();
    }

    // ===== Beta: accounts and campaigns =====
    // A real account (Google or email), not the main site's anonymous device sign-in.
    // A suspended account (bans/{uid}) can still read but can't change anything.
    function realUser() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'
      && (request.method in ['get', 'list'] || !exists(/databases/$(database)/documents/bans/$(request.auth.uid))); }
    // Site admins: an admins/{uid} document made by hand in the Firebase console.
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }
    match /bans/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin() && request.auth.uid != uid
        && request.resource.data.keys().hasOnly(['at', 'by', 'name']);
      allow delete: if isAdmin();
    }

    // Public profile: just a username. Emails are never stored here.
    match /users/{uid} {
      allow read: if realUser();
      allow create, update: if realUser() && (request.auth.uid == uid || isAdmin())
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'created', 'lastSeen', 'color', 'icon'])
        && request.resource.data.get('lastSeen', 0) is int
        && request.resource.data.get('color', '') is string && request.resource.data.get('color', '').size() <= 12
        && request.resource.data.get('icon', '') is string && request.resource.data.get('icon', '').size() <= 4
        && request.resource.data.username is string
        && request.resource.data.username.matches('[A-Za-z0-9_]{3,20}')
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid;
      allow delete: if realUser() && (request.auth.uid == uid || isAdmin());
    }
    // Username claims, so two people can't take the same one.
    match /usernames/{name} {
      allow read: if realUser();
      allow create: if realUser() && name.matches('[a-z0-9_]{3,20}')
        && request.resource.data.keys().hasOnly(['uid']) && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if realUser() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    // Campaigns: members can see them. The owner creates, renames, picks the GM, removes members and deletes.
    // An invited player can add themselves; any member except the owner can leave.
    match /campaigns/{cid} {
      function oldC() { return resource.data; }
      function newC() { return request.resource.data; }
      function me() { return request.auth.uid; }
      function changedOnly(keys) { return newC().diff(oldC()).affectedKeys().hasOnly(keys); }
      function isOwner() { return oldC().ownerUid == me(); }
      function goodName() { return newC().name is string && newC().name.size() > 0 && newC().name.size() <= 60; }
      function gmOf(d) { return d.get('gmUid', null); }
      function ownerManages() {
        return isOwner() && changedOnly(['memberIds', 'roles', 'names', 'gmUid'])
          && oldC().memberIds.hasAll(newC().memberIds)
          && me() in newC().memberIds && newC().roles[me()] == 'owner'
          && newC().roles.keys().hasOnly(newC().memberIds)
          && newC().names.keys().hasOnly(newC().memberIds)
          && (gmOf(newC()) == null || gmOf(newC()) in newC().memberIds);
      }
      function myEmail() { return request.auth.token.email.lower(); }
      function invited() {
        return request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/invites/$(cid + '_' + myEmail()));
      }
      function hasLink() {
        return oldC().get('joinCode', '') != ''
          && getAfter(/databases/$(database)/documents/joinreq/$(cid + '_' + me())).data.code == oldC().joinCode;
      }
      function joining() {
        return !(me() in oldC().memberIds)
          && (invited() || hasLink())
          && changedOnly(['memberIds', 'roles', 'names'])
          && newC().memberIds == oldC().memberIds.concat([me()])
          && newC().memberIds.size() <= 12
          && newC().roles.diff(oldC().roles).affectedKeys().hasOnly([me()]) && newC().roles[me()] == 'player'
          && newC().names.diff(oldC().names).affectedKeys().hasOnly([me()])
          && newC().names[me()] == get(/databases/$(database)/documents/users/$(me())).data.username;
      }
      function leaving() {
        return me() in oldC().memberIds && !isOwner()
          && changedOnly(['memberIds', 'roles', 'names', 'gmUid'])
          && newC().memberIds == oldC().memberIds.removeAll([me()])
          && !(me() in newC().roles) && newC().roles.diff(oldC().roles).affectedKeys().hasOnly([me()])
          && !(me() in newC().names) && newC().names.diff(oldC().names).affectedKeys().hasOnly([me()])
          && (gmOf(newC()) == gmOf(oldC()) || (gmOf(oldC()) == me() && gmOf(newC()) == null));
      }
      allow read: if (realUser() && me() in resource.data.memberIds) || isAdmin();
      allow create: if realUser()
        && newC().keys().hasOnly(['name', 'ownerUid', 'memberIds', 'roles', 'names', 'created'])
        && newC().ownerUid == me()
        && newC().memberIds == [me()]
        && newC().roles.keys().hasOnly([me()]) && newC().roles[me()] == 'owner'
        && goodName();
      // Once a campaign is marked for deletion nothing else about it can change, so the flag can't be used to keep reading GM material.
      allow update: if realUser() && oldC().get('deleting', false) != true && (
        (isOwner() && changedOnly(['name']) && goodName())
        || (isOwner() && changedOnly(['ownerEdits']) && newC().ownerEdits is bool)
        || (isOwner() && changedOnly(['photo']) && (!('photo' in newC()) || (newC().photo is string && newC().photo.matches('data:image/jpeg;base64,.*') && newC().photo.size() < 150000)))
        || (isOwner() && changedOnly(['joinCode']) && newC().joinCode is string && newC().joinCode.size() >= 10 && newC().joinCode.size() <= 40)
        || (isOwner() && changedOnly(['deleting']) && newC().deleting == true)
        || ownerManages() || joining() || leaving()
        || (isAdmin() && changedOnly(['memberIds', 'roles', 'names', 'gmUid'])
          && oldC().memberIds.hasAll(newC().memberIds) && oldC().ownerUid in newC().memberIds
          && newC().roles[oldC().ownerUid] == 'owner'));
      allow delete: if (realUser() && isOwner()) || isAdmin();

      // ----- The ledger inside a campaign -----
      // (The owner can delete anything here, so deleting a campaign can clean up after itself.)
      function C() { return get(/databases/$(database)/documents/campaigns/$(cid)).data; }
      function member() { return realUser() && request.auth.uid in C().memberIds; }
      function cOwner() { return realUser() && C().ownerUid == request.auth.uid; }
      function cGM() { return realUser() && C().get('gmUid', null) == request.auth.uid; }
      function gmSees() { return cGM(); }
      // Wiping a campaign: an admin, or the owner once the campaign is marked as being deleted.
      function cleaner() { return isAdmin() || (cOwner() && C().get('deleting', false) == true); }
      function playerDoc() { return /databases/$(database)/documents/campaigns/$(cid)/players/$(request.auth.uid); }
      // A player (not the owner) gets exactly one investigator: players/{uid} records which one.
      function takesOnly(slot) { return !exists(playerDoc()) && getAfter(playerDoc()).data.slot == slot; }
      function sheetOwner(s) { return get(/databases/$(database)/documents/campaigns/$(cid)/characters/$(s)).data.get('ownerUid', null); }
      function plays(s) { return isSlot(s) && sheetOwner(s) == request.auth.uid; }

      // Investigators: everyone in the campaign can see them. A player edits their own; the owner edits any and can make
      // any number; other players make or claim one. The GM can award XP, start sessions and refill pools.
      match /characters/{slot} {
        function oldOwner() { return resource.data.get('ownerUid', null); }
        function newOwner() { return request.resource.data.get('ownerUid', null); }
        function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
        allow read: if (member()) || cleaner();
        allow create: if isSlot(slot) && (cOwner() || (member() && newOwner() == request.auth.uid && takesOnly(slot)));
        allow update: if member() && isSlot(slot) && (
          cOwner()
          || (oldOwner() == request.auth.uid && (newOwner() == request.auth.uid || newOwner() == null))
          || (cGM() && changed().hasOnly(['xpTotal','xpUnused','insightChance','insight','habitual','lucky','traumaMod','regular','horror','log']))
          || ((oldOwner() == null || !(oldOwner() in C().memberIds)) && newOwner() == request.auth.uid && changed().hasOnly(['ownerUid', 'player']) && takesOnly(slot)));
        allow delete: if (cOwner()) || cleaner();
      }
      // Which investigator each player has (see takesOnly). The owner can change it when assigning sheets.
      match /players/{uid} {
        function slotOwner(s) { return getAfter(/databases/$(database)/documents/campaigns/$(cid)/characters/$(s)).data.get('ownerUid', null); }
        allow read: if (member()) || cleaner();
        allow create: if cOwner() || (member() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['slot']) && isSlot(request.resource.data.slot)
          && slotOwner(request.resource.data.slot) == request.auth.uid);
        allow update: if cOwner();
        allow delete: if (cOwner() || (uid == request.auth.uid && (resource == null
          || !existsAfter(/databases/$(database)/documents/campaigns/$(cid)/characters/$(resource.data.slot))
            || slotOwner(resource.data.slot) != request.auth.uid))) || cleaner();
      }
      // Turn tracker and campaign tracker: everyone reads, the GM writes.
      match /table/{doc} {
        allow create, update: if cOwner();  // lets the owner import the original ledger without becoming GM
        allow delete: if (cOwner()) || cleaner();
        allow read: if (member()) || cleaner();
        allow write: if cGM() && doc == 'state';
      }
      match /campaign/{doc} {
        allow create, update: if cOwner();  // lets the owner import the original ledger without becoming GM
        allow delete: if (cOwner()) || cleaner();
        allow read: if (member()) || cleaner();
        allow write: if cGM();
      }
      // Enemies and handouts: players only see what the GM reveals (a handout to one player only to that player).
      match /enemies/{id} {
        allow create, update: if cOwner();  // lets the owner import the original ledger without becoming GM
        allow delete: if (cOwner()) || cleaner();
        allow read: if (gmSees() || (member() && resource.data.shown == true)) || cleaner();
        allow write: if cGM();
      }
      match /clues/{id} {
        allow create, update: if cOwner();  // lets the owner import the original ledger without becoming GM
        allow delete: if (cOwner()) || cleaner();
        allow read: if (gmSees() || (member() && resource.data.shown == true
          && (resource.data.to == 'all' || plays(resource.data.to)))) || cleaner();
        allow write: if cGM();
      }
      match /gm/{doc} {
        allow delete: if (cOwner()) || cleaner();
        allow read: if (gmSees()) || cleaner();
        allow write: if cGM();
      }
      match /gmlog/{id} {
        allow delete: if (cOwner()) || cleaner();
        allow read: if (gmSees()) || cleaner();
        allow create, delete: if cGM();
      }
      match /history/{id} {
        allow update: if cOwner();  // re-running the import
        allow read: if (member()) || cleaner();
        allow create: if member() && request.resource.data.slot is string
          && ((request.resource.data.slot == 'gm' && cGM())
            || (isSlot(request.resource.data.slot) && (cOwner() || cGM() || plays(request.resource.data.slot))));
        allow delete: if (gmSees()) || cleaner();
      }
      // House rules (on/off plus the campaign's own weapons, equipment and rule changes): the owner decides.
      match /settings/{doc} {
        allow delete: if (cOwner()) || cleaner();
        allow read: if (member()) || cleaner();
        allow write: if cOwner() && doc == 'house'
          && request.resource.data.keys().hasOnly(['on', 'weapons', 'gear', 'rules', 'hidden'])
          && request.resource.data.get('on', false) is bool
          && request.resource.data.get('weapons', []) is list && request.resource.data.get('weapons', []).size() <= 40
          && request.resource.data.get('gear', []) is list && request.resource.data.get('gear', []).size() <= 60
          && request.resource.data.get('rules', []) is list && request.resource.data.get('rules', []).size() <= 10
          && request.resource.data.get('hidden', []) is list && request.resource.data.get('hidden', []).size() <= 100;
      }
    }

    // Invites by email: the owner adds one; whoever signs in with that (verified) email can join or decline.
    match /invites/{iid} {
      function camp(c) { return get(/databases/$(database)/documents/campaigns/$(c)).data; }
      function myEmail() { return request.auth.token.email.lower(); }
      function isInvitee() { return request.auth.token.email_verified == true && resource.data.toEmail == myEmail(); }
      allow read: if (realUser() && (resource.data.fromUid == request.auth.uid || isInvitee())) || isAdmin();
      allow create: if realUser()
        && request.resource.data.keys().hasOnly(['cid', 'campaignName', 'fromUid', 'fromName', 'toEmail', 'created'])
        && request.resource.data.toEmail is string
        && request.resource.data.toEmail.size() <= 120
        && request.resource.data.toEmail.matches('[^@/ ]+@[^@/ ]+[.][^@/ ]+')
        && request.resource.data.toEmail == request.resource.data.toEmail.lower()
        && iid == request.resource.data.cid + '_' + request.resource.data.toEmail
        && request.resource.data.fromUid == request.auth.uid
        && camp(request.resource.data.cid).ownerUid == request.auth.uid
        && request.resource.data.campaignName == camp(request.resource.data.cid).name
        && request.resource.data.fromName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
      allow delete: if (realUser() && (resource.data.fromUid == request.auth.uid || isInvitee())) || isAdmin();
    }
    // Proof that someone opened a campaign's invite link (checked when they add themselves).
    match /joinreq/{rid} {
      allow create, update: if realUser()
        && request.resource.data.keys().hasOnly(['cid', 'code'])
        && rid == request.resource.data.cid + '_' + request.auth.uid
        && request.resource.data.code is string && request.resource.data.code.size() <= 40;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
