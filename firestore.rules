rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Investigator sheets are p1 to p12.
    function isSlot(s) { return s.matches('p([1-9]|1[0-2])'); }
    function signedIn() { return request.auth != null; }
    function lockDoc(s) { return /databases/$(database)/documents/locks/$(s); }
    function grantDoc(s) { return /databases/$(database)/documents/grants/$(request.auth.uid)/keys/$(s); }

    // This device unlocked slot s (or 'master') with the passcode that is set right now.
    function holdsKey(s) {
      return signedIn() && exists(lockDoc(s)) && exists(grantDoc(s))
        && get(grantDoc(s)).data.code == get(lockDoc(s)).data.code;
    }
    function isMaster() { return holdsKey('master'); }
    // The GM chooses their own PIN (locks/gm). It runs the GM tools; the master key can view them and reset the PIN.
    function isGM() { return holdsKey('gm'); }
    function gmView() { return isGM() || isMaster(); }
    function canEdit(s) { return isMaster() || !exists(lockDoc(s)) || holdsKey(s); }

    // Character sheets: everyone can view; editing a locked sheet needs its passcode or the master key.
    // Anyone can add a new investigator; only the master key can remove one.
    match /characters/{slot} {
      allow read: if true;
      allow create, update: if isSlot(slot) && signedIn() && canEdit(slot);
      allow delete: if isSlot(slot) && isMaster();
      // The GM can award XP, start sessions and refill pools on any sheet, but nothing else.
      allow update: if isSlot(slot) && isGM() && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['xpTotal','xpUnused','insightChance','insight','habitual','lucky','traumaMod','regular','horror','log']);
    }

    // Passcodes: nobody can read them. Set one on an open sheet; change or remove it with the passcode or master key.
    // The master key (locks/master) can only be set in the Firebase console.
    // locks/gm is the GM PIN: anyone can set it while none exists; the GM or the master key can change or clear it.
    match /locks/{slot} {
      allow read: if false;
      allow create: if (isSlot(slot) || slot == 'gm') && signedIn() && request.resource.data.code is string
        && request.resource.data.code.size() >= 4 && request.resource.data.code.size() <= 64;
      allow update: if (isSlot(slot) || slot == 'gm') && (isMaster() || holdsKey(slot)) && request.resource.data.code is string
        && request.resource.data.code.size() >= 4 && request.resource.data.code.size() <= 64;
      allow delete: if (isSlot(slot) || slot == 'gm') && (isMaster() || holdsKey(slot));
    }

    // A device's saved keys: grants/{device}/keys/{slot or 'master'}.
    // Only that device can see or delete them, and a key is only accepted if its code is correct.
    match /grants/{owner}/keys/{slot} {
      allow read, delete: if signedIn() && request.auth.uid == owner;
      allow create, update: if signedIn() && request.auth.uid == owner
        && (isSlot(slot) || slot == 'master' || slot == 'gm')
        && exists(lockDoc(slot))
        && request.resource.data.code == get(lockDoc(slot)).data.code;
    }

    // Party settings (house rules on/off): everyone can read, only the master key can change.
    match /settings/{doc} {
      allow read: if true;
      allow write: if isMaster() && doc == 'house' && request.resource.data.keys().hasOnly(['on'])
        && request.resource.data.on is bool;
      // settings/gm just says whether a GM PIN is set, so the page knows what to show.
      allow write: if doc == 'gm' && (isGM() || isMaster()) && request.resource.data.keys().hasOnly(['set'])
        && request.resource.data.set is bool;
    }

    // GM tools. Turn tracker and campaign: everyone reads, only the GM writes.
    match /table/{doc} {
      allow read: if true;
      allow write: if isGM() && doc == 'state';
    }
    match /campaign/{doc} {
      allow read: if true;
      allow write: if isGM();
    }
    // Enemies and handouts: players only see what the GM has revealed (a handout to one player needs that sheet's key).
    match /enemies/{id} {
      allow read: if gmView() || resource.data.shown == true;
      allow write: if isGM();
    }
    match /clues/{id} {
      allow read: if gmView() || (resource.data.shown == true
        && (resource.data.to == 'all' || (isSlot(resource.data.to) && canEdit(resource.data.to))));
      allow write: if isGM();
    }
    // Private GM notes.
    match /gm/{doc} {
      allow read: if gmView();
      allow write: if isGM();
    }
    // The GM's own activity log.
    match /gmlog/{id} {
      allow read: if gmView();
      allow create, delete: if isGM();
    }
    // Activity history for session recaps: anyone who can edit a sheet can add to its history.
    match /history/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.slot is string
        && ((isSlot(request.resource.data.slot) && (canEdit(request.resource.data.slot) || isGM()))
          || (request.resource.data.slot == 'gm' && isGM()));
      allow delete: if gmView();
    }

    // ===== Beta: accounts and campaigns =====
    // A real account (Google or email), not the main site's anonymous device sign-in.
    function realUser() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }

    // Public profile: just a username. Emails are never stored here.
    match /users/{uid} {
      allow read: if realUser();
      allow create, update: if realUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'created'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('[A-Za-z0-9_]{3,20}')
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid;
    }
    // Username claims, so two people can't take the same one.
    match /usernames/{name} {
      allow read: if realUser();
      allow create: if realUser() && name.matches('[a-z0-9_]{3,20}')
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow delete: if realUser() && resource.data.uid == request.auth.uid;
    }
    // Campaigns: members can see them. The owner creates, renames, picks the GM, removes members and deletes.
    // An invited player can add themselves; any member except the owner can leave.
    match /campaigns/{cid} {
      function oldC() { return resource.data; }
      function newC() { return request.resource.data; }
      function me() { return request.auth.uid; }
      function changedOnly(keys) { return newC().diff(oldC()).affectedKeys().hasOnly(keys); }
      function isOwner() { return oldC().ownerUid == me(); }
      function goodName() { return newC().name is string && newC().name.size() > 0 && newC().name.size() <= 60; }
      function gmOf(d) { return d.get('gmUid', null); }
      function ownerManages() {
        return isOwner() && changedOnly(['memberIds', 'roles', 'names', 'gmUid'])
          && oldC().memberIds.hasAll(newC().memberIds)
          && me() in newC().memberIds && newC().roles[me()] == 'owner'
          && newC().roles.keys().hasOnly(newC().memberIds)
          && newC().names.keys().hasOnly(newC().memberIds)
          && (gmOf(newC()) == null || gmOf(newC()) in newC().memberIds);
      }
      function joining() {
        return !(me() in oldC().memberIds)
          && exists(/databases/$(database)/documents/invites/$(cid + '_' + me()))
          && changedOnly(['memberIds', 'roles', 'names'])
          && newC().memberIds == oldC().memberIds.concat([me()])
          && newC().memberIds.size() <= 12
          && newC().roles.diff(oldC().roles).affectedKeys().hasOnly([me()]) && newC().roles[me()] == 'player'
          && newC().names.diff(oldC().names).affectedKeys().hasOnly([me()])
          && newC().names[me()] == get(/databases/$(database)/documents/users/$(me())).data.username;
      }
      function leaving() {
        return me() in oldC().memberIds && !isOwner()
          && changedOnly(['memberIds', 'roles', 'names', 'gmUid'])
          && newC().memberIds == oldC().memberIds.removeAll([me()])
          && !(me() in newC().roles) && newC().roles.diff(oldC().roles).affectedKeys().hasOnly([me()])
          && !(me() in newC().names) && newC().names.diff(oldC().names).affectedKeys().hasOnly([me()])
          && (gmOf(newC()) == gmOf(oldC()) || (gmOf(oldC()) == me() && gmOf(newC()) == null));
      }
      allow read: if realUser() && me() in resource.data.memberIds;
      allow create: if realUser()
        && newC().keys().hasOnly(['name', 'ownerUid', 'memberIds', 'roles', 'names', 'created'])
        && newC().ownerUid == me()
        && newC().memberIds == [me()]
        && newC().roles.keys().hasOnly([me()]) && newC().roles[me()] == 'owner'
        && goodName();
      allow update: if realUser() && (
        (isOwner() && changedOnly(['name']) && goodName())
        || ownerManages() || joining() || leaving());
      allow delete: if realUser() && isOwner();
    }

    // Invites: the owner invites someone by username; the invitee joins or declines; either side can delete it.
    match /invites/{iid} {
      function camp(c) { return get(/databases/$(database)/documents/campaigns/$(c)).data; }
      function uname(u) { return get(/databases/$(database)/documents/users/$(u)).data.username; }
      allow read: if realUser() && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow create: if realUser()
        && request.resource.data.keys().hasOnly(['cid', 'campaignName', 'fromUid', 'fromName', 'toUid', 'toName', 'created'])
        && iid == request.resource.data.cid + '_' + request.resource.data.toUid
        && request.resource.data.fromUid == request.auth.uid
        && camp(request.resource.data.cid).ownerUid == request.auth.uid
        && !(request.resource.data.toUid in camp(request.resource.data.cid).memberIds)
        && request.resource.data.campaignName == camp(request.resource.data.cid).name
        && request.resource.data.toName == uname(request.resource.data.toUid)
        && request.resource.data.fromName == uname(request.auth.uid);
      allow delete: if realUser() && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
